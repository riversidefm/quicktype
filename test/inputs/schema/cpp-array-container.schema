{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CppArrayContainer",
  "type": "object",
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Event"
      }
    },
    "largeObjects": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/LargeObject"
      }
    },
    "smallObjects": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/SmallObject"
      }
    },
    "numbers": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    }
  },
  "required": ["events", "largeObjects", "smallObjects", "numbers"],
  "definitions": {
    "Event": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "LargeObject": {
      "type": "object",
      "properties": {
        "id": { "type": "integer" },
        "data": { "type": "string" },
        "payload": { "type": "string" }
      },
      "required": ["id", "data", "payload"]
    },
    "SmallObject": {
      "type": "object",
      "properties": {
        "value": { "type": "string" }
      },
      "required": ["value"]
    }
  }
}

