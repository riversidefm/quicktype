{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "types/KeyFrame.json",
  "definitions": {
    "Event": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "value": { "type": "object" }
      },
      "required": ["type"]
    }
  },
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "events": {
      "type": "array",
      "items": { "$ref": "#/definitions/Event" }
    }
  },
  "required": ["id", "events"]
}

