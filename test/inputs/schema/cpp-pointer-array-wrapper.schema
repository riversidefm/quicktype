{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pointer Array Wrapper Test",
  "type": "object",
  "properties": {
    "raw_pointers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Node"
      }
    },
    "const_pointers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ConstNode"
      }
    },
    "mixed_objects": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/RegularObject"
      }
    }
  },
  "required": ["raw_pointers", "const_pointers", "mixed_objects"],
  "definitions": {
    "Node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        }
      },
      "required": ["id", "name"]
    },
    "ConstNode": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        }
      },
      "required": ["value"]
    },
    "RegularObject": {
      "type": "object",
      "properties": {
        "data": {
          "type": "string"
        }
      },
      "required": ["data"]
    }
  }
}
